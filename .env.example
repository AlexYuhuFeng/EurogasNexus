# Eurogas Nexus environment template - development
#
# GENERATED FILE: do not hand-edit. It is rendered from
# src/eurogas_nexus/core/config_contract.py, and
# `python scripts/ci/check_config_contract.py` fails the build when this file and
# that contract disagree. Regenerate with:
#
#     python scripts/ci/generate_env_template.py
#
# Values shown are non-secret examples or defaults. Entries commented out with a
# leading `#` are optional; those marked "Required:" must be set before the
# deployment can serve. Secret values must be injected at deploy time and never
# committed.

# --- Deployment identity ---

# Runtime environment. Selects fail-closed behaviour (trial/release).
# Default: development
EUROGAS_NEXUS_ENV=development

# Route profile: which API surfaces are mounted.
# Default: development
# release hides /docs and /openapi.json and mounts no development routes
EUROGAS_NEXUS_API_PROFILE=development

# Application version reported by the runtime and release endpoints.
# Normally stamped by the release tooling; do not hand-edit in a release
# Must match the packaged version or the version-consistency gate fails
EUROGAS_NEXUS_VERSION=0.6.0

# Release channel: preview, rc or stable.
# Default: preview
EUROGAS_NEXUS_RELEASE_CHANNEL=preview

# Deployment network posture: private_network_preview or security_accepted.
# Default: private_network_preview
EUROGAS_NEXUS_DEPLOYMENT_POSTURE=private_network_preview

# Path to the operator-reviewed security-acceptance evidence file.
# Required when: deployment posture is security_accepted
EUROGAS_NEXUS_SECURITY_ACCEPTANCE_EVIDENCE=

# --- Runtime store (PostgreSQL) ---

# PostgreSQL DSN for the runtime store (the source of truth).
# Required when: any DB-backed workflow is used
# Accepted aliases: DATABASE_URL, EUROGAS_NEXUS_DB_DSN
# Accepted aliases are read in the order shown; the first non-blank wins.
# Without it the API still starts, but every DB-backed read reports a diagnostic state instead of data.
# Secret: inject at deploy time; never commit a real value.
RUNTIME_STORE_DATABASE_URL=

# Alias for RUNTIME_STORE_DATABASE_URL (lower precedence).
# Secret: inject at deploy time; never commit a real value.
DATABASE_URL=

# Alias for RUNTIME_STORE_DATABASE_URL (lowest precedence).
# Secret: inject at deploy time; never commit a real value.
EUROGAS_NEXUS_DB_DSN=

# Echo SQL to the log. Development diagnosis only.
# Default: false
# Never enable in a delivery: statements can carry business values
EUROGAS_NEXUS_DB_ECHO=false

# Verify pooled connections before use.
# Default: true
EUROGAS_NEXUS_DB_POOL_PRE_PING=true

# SQLAlchemy pool size for the runtime store.
# Default: 10
# Size against the PostgreSQL connection limit shared by every worker
EUROGAS_NEXUS_DB_POOL_SIZE=10

# Extra connections permitted above the pool size.
# Default: 20
EUROGAS_NEXUS_DB_MAX_OVERFLOW=20

# Seconds to wait for a pooled connection before failing.
# Default: 5.0
EUROGAS_NEXUS_DB_POOL_TIMEOUT=5.0

# Seconds after which a pooled connection is recycled.
# Default: 1800
EUROGAS_NEXUS_DB_POOL_RECYCLE=1800

# --- Caller identity and secrets ---

# Deployment token presented by SDK, CLI and service callers.
# Required when: any non-health route is served (otherwise the API refuses with 503)
# Every route profile identifies its callers, so an unconfigured token fails closed rather than serving unauthenticated callers.
# Secret: inject at deploy time; never commit a real value.
EUROGAS_NEXUS_PUBLIC_API_TOKEN=

# Token for the internal route profile (operator and tooling actions).
# Required when: the internal profile is mounted
# Secret: inject at deploy time; never commit a real value.
EUROGAS_NEXUS_INTERNAL_API_TOKEN=

# Master key encrypting provider credentials at rest and keying identity digests.
# Required when: any provider credential is stored
# A 32-byte urlsafe-base64 Fernet key is used as given; any other value is hashed to derive the key.
# Rotating it makes previously stored provider credentials undecryptable: re-enter them after a rotation.
# Secret: inject at deploy time; never commit a real value.
EUROGAS_NEXUS_SECRET_KEY=

# Permit callers that present no credential (pre-D1 posture).
# Default: 0
# Set to 1 only when the deployment really does trust its network; the health payload then reports authentication=anonymous_allowed.
EUROGAS_NEXUS_ALLOW_ANONYMOUS_CALLERS=0

# --- Enterprise SSO (OIDC) ---

# OIDC issuer URL for interactive SSO login.
# Required when: interactive SSO is offered
EUROGAS_NEXUS_OIDC_ISSUER=https://idp.example.com/realms/trading

# OIDC client id registered for this deployment.
# Required when: interactive SSO is offered
EUROGAS_NEXUS_OIDC_CLIENT_ID=

# OIDC client secret for the authorization-code exchange.
# Required when: the identity provider requires a confidential client
# Secret: inject at deploy time; never commit a real value.
EUROGAS_NEXUS_OIDC_CLIENT_SECRET=

# Redirect URI registered with the identity provider.
# Required when: interactive SSO is offered
EUROGAS_NEXUS_OIDC_REDIRECT_URI=https://nexus.example.com/api/auth/oidc/callback

# Expected token audience (defaults to the client id).
EUROGAS_NEXUS_OIDC_AUDIENCE=

# Token claim carrying role names.
# Default: roles
EUROGAS_NEXUS_OIDC_ROLE_CLAIM=roles

# Token claim carrying commercial data scopes.
# Default: entitlements
EUROGAS_NEXUS_OIDC_SCOPE_CLAIM=entitlements

# How SSO identities become users: preprovisioned, approved_domain (registered PENDING), or directory (created active; roles, scopes and office follow directory groups at every sign-in).
# Default: preprovisioned
# approved_domain registers a PENDING identity and still refuses access until an administrator activates it.
EUROGAS_NEXUS_OIDC_PROVISIONING_MODE=preprovisioned

# Comma-separated email domains eligible for just-in-time registration.
EUROGAS_NEXUS_OIDC_APPROVED_DOMAINS=example.com,trading.example.com

# Mapping from identity-provider groups to roles.
EUROGAS_NEXUS_OIDC_GROUPS_ROLE_MAP=

# Mapping from identity-provider groups to commercial data scopes.
EUROGAS_NEXUS_OIDC_GROUPS_SCOPE_MAP=

# Permit a plain-HTTP issuer. Development only.
# Default: 0
# Never enable in a delivery: token validation would cross cleartext
EUROGAS_NEXUS_OIDC_ALLOW_HTTP=0

# --- Browser, gateway and TLS termination ---

# Extra browser origins allowed for cookie-authenticated requests.
# Required when: the web client is served from an origin the middleware cannot derive, including any development install using the Vite dev server
# The origin guard also accepts a same-origin request derived from the Host header plus X-Forwarded-Proto, so a production deployment that serves the client and the API from one host needs nothing here.
# A development install does: the Vite dev server runs on its own port (3000 by default) while the API listens on another, so the browser's Origin names the dev-server port and the derived value does not match. Without this value every cookie-authenticated mutation is refused with origin_not_allowed, and the browser console shows the refusal without naming its cause. Set it to the origin the browser loads, for example http://127.0.0.1:3000.
EUROGAS_NEXUS_CORS_ORIGINS=https://nexus.example.com

# Proxy addresses whose X-Forwarded-* headers are trusted (read by uvicorn).
# Required when: the API runs behind a reverse proxy that terminates TLS
# Read by: uvicorn
# uvicorn defaults to 127.0.0.1,::1, which excludes a sidecar proxy on a container network: without this the request scheme stays http and the session cookie is issued without the Secure attribute.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# --- Research artifact storage ---

# Filesystem root for materialized research dataset artifacts.
# Defaults to the git-ignored data/snapshots directory of the deployment checkout
EUROGAS_NEXUS_RESEARCH_ARTIFACT_ROOT=data/snapshots

# --- Model and source behaviour ---

# Permit calls to an external LLM provider.
# Default: true (forced false in trial and release)
# Trial and release force this off; the override is ignored there.
# Enabling it in development sends the request payload to the provider.
EUROGAS_NEXUS_LLM_EXTERNAL_PROVIDER_ENABLED=true (forced false in trial and release)

# Permit simulated market price sources.
# Default: true (forced false in trial and release)
# Simulated rows are labelled and are never provider acceptance
EUROGAS_NEXUS_ENABLE_SIMULATED_SOURCES=true (forced false in trial and release)

# API key for GIE AGSI/ALSI storage and LNG transparency data.
# Required when: GIE storage or LNG ingestion is enabled
# Secret: inject at deploy time; never commit a real value.
GIE_API_KEY=

# Path to a file holding the GIE API key, read at ingest time.
# Required when: GIE ingestion is enabled and GIE_API_KEY or the encrypted credential store does not hold the key
# Precedence: GIE_API_KEY, then GIE_API_KEY_FILE, then the encrypted provider credential store.
# Keep the key file outside the repository and readable only by the runtime account; the file content is never logged.
GIE_API_KEY_FILE=

# --- Worker and agent identities ---

# Persisted SERVICE principal the headless monitoring worker acts as.
# Required when: the monitoring worker runs with provider enrichment
EUROGAS_NEXUS_WORKER_PRINCIPAL=

# Principal id used by the stdio MCP server.
# Default: service:mcp
EUROGAS_NEXUS_AGENT_PRINCIPAL=service:mcp

# Role used by the stdio MCP server.
# Default: ANALYST
EUROGAS_NEXUS_AGENT_ROLE=ANALYST

# Comma-separated data scopes used by the stdio MCP server.
EUROGAS_NEXUS_AGENT_DATA_SCOPES=

# Backend base URL the stdio MCP server calls.
# Default: http://127.0.0.1:8000/api
EUROGAS_NEXUS_API_BASE_URL=http://127.0.0.1:8000/api

# --- SDK and CLI client identity ---

# Alias for EUROGAS_NEXUS_PUBLIC_API_TOKEN accepted by the SDK and CLI.
# Accepted aliases: EUROGAS_NEXUS_PUBLIC_API_TOKEN
# The SDK reads EUROGAS_NEXUS_PUBLIC_API_TOKEN first and falls back to this older client-side name, so an existing SDK environment keeps working
# Secret: inject at deploy time; never commit a real value.
EUROGAS_NEXUS_API_TOKEN=

# Principal name the SDK/CLI attributes its requests to.
# Sent as X-Eurogas-Principal. It is an attribution label, not a credential: the deployment token is what authenticates the caller
EUROGAS_NEXUS_PRINCIPAL=

# Identity key the SDK/CLI presents as X-Eurogas-Identity.
# Prefer a per-caller identity key over the shared deployment token so role floors and data scopes are actually enforced
# Secret: inject at deploy time; never commit a real value.
EUROGAS_NEXUS_IDENTITY_BEARER=

# --- Development-only credential login ---

# Development-only credential login username.
# Mounted by the development route profile only; never set in trial or release, and never reuse a real user password.
# Secret: inject at deploy time; never commit a real value.
EUROGAS_NEXUS_DEV_LOGIN_USERNAME=

# Development-only credential login password.
# Secret: inject at deploy time; never commit a real value.
EUROGAS_NEXUS_DEV_LOGIN_PASSWORD=

# Acknowledge that a UAT fixture seed may write to the runtime store.
# The fixture gate refuses to run in trial or release regardless
EUROGAS_NEXUS_UAT_FIXTURE_ALLOWED=

# --- Deployment bundle ---

# Container image reference the deployment compose file runs.
# Required when: deploying with deploy/runtime/compose.yaml
# Read by: compose
# Pin by digest rather than tag so a rollback names an immutable image
# The operator ZIP writes this into the bundle's environment file
EUROGAS_NEXUS_API_IMAGE=registry.example.com/eurogas-nexus-api@sha256:0000...

# --- Release and supply-chain tooling ---

# Base URL the release smoke test calls.
# Default: http://127.0.0.1:8000/api
EUROGAS_NEXUS_RELEASE_BASE_URL=http://127.0.0.1:8000/api

# Path to signtool.exe for Windows Authenticode signing.
# Required when: signed Windows artifacts are produced
EUROGAS_NEXUS_SIGNTOOL_PATH=

# Request Authenticode signing of the Windows artifacts.
# Default: 0
# Stable promotion stays blocked until signing evidence exists
EUROGAS_NEXUS_WINDOWS_CODE_SIGNING_ENABLED=0

# Request GPG signing of the release artifacts.
# Default: 0
EUROGAS_NEXUS_GPG_SIGNING_ENABLED=0

# GPG key id used to sign release artifacts.
# Required when: GPG-signed release artifacts are produced
EUROGAS_NEXUS_GPG_SIGNING_KEY_ID=

# Path to the Windows code-signing certificate.
# Required when: signed Windows artifacts are produced
# Secret: inject at deploy time; never commit a real value.
WINDOWS_SIGNING_CERT_PATH=

# Password for the Windows code-signing certificate.
# Required when: signed Windows artifacts are produced
# Secret: inject at deploy time; never commit a real value.
WINDOWS_SIGNING_PASSWORD=

# RFC 3161 timestamp authority used when signing.
# Default: http://timestamp.digicert.com
WINDOWS_SIGNING_TIMESTAMP_URL=http://timestamp.digicert.com

# Path the security-acceptance runner reports its evidence into.
# Read by the runner snippet this product writes into an evidence file, not by the product's own process
EUROGAS_G8_SELECTION_EVIDENCE=

# Endpoint the cost-observation refresh reads.
EUROGAS_NEXUS_COST_SOURCE_URL=

# Source-system label applied by the cost-observation refresh.
# Default: TSO_TARIFFS
EUROGAS_NEXUS_COST_SOURCE_SYSTEM=TSO_TARIFFS

# Key that signs decision hand-offs (HMAC-SHA256) read by ERP/ETRM middleware; the receiver holds the same key to verify them.
# Required when: decision hand-offs are used (docs/integration/ERP_ETRM_INTEGRATION.md)
# Secret: inject at deploy time; never commit a real value.
EUROGAS_NEXUS_HANDOFF_SIGNING_KEY=

# Accept the user and groups asserted by an authenticating reverse proxy (SAML, Kerberos/SPNEGO or a vendor SSO agent) in a dedicated network.
# Requires EUROGAS_NEXUS_GATEWAY_SECRET; see docs/operations/ENTERPRISE_SSO.md
EUROGAS_NEXUS_GATEWAY_AUTH_ENABLED=false

# Shared secret the gateway sends in X-Eurogas-Gateway-Secret (32+ characters).
# Required when: EUROGAS_NEXUS_GATEWAY_AUTH_ENABLED is true
# Secret: inject at deploy time; never commit a real value.
EUROGAS_NEXUS_GATEWAY_SECRET=

# Comma-separated CIDRs the gateway connects from; requests from elsewhere fail.
EUROGAS_NEXUS_GATEWAY_TRUSTED_PROXIES=10.20.0.0/24

# Header carrying the authenticated user name.
EUROGAS_NEXUS_GATEWAY_USER_HEADER=X-Remote-User

# Header carrying the user's groups, comma or semicolon separated.
EUROGAS_NEXUS_GATEWAY_GROUPS_HEADER=X-Remote-Groups

# Header carrying the user's office code (directory mode sets the profile office).
EUROGAS_NEXUS_GATEWAY_OFFICE_HEADER=X-Remote-Office

# OIDC claim carrying the user's office code (directory provisioning mode).
EUROGAS_NEXUS_SSO_OFFICE_CLAIM=office

# The firm's REMIT market participant names or ACER codes as they appear in UMMs (comma-separated), so surveillance recognises outages at the firm's own assets.
EUROGAS_NEXUS_REMIT_OWN_PARTICIPANTS=Example Energy Trading Ltd,A0001234X.GB

# Where this installation serves users: global (default) or china.
# Selects region-appropriate defaults such as the basemap
EUROGAS_NEXUS_DEPLOYMENT_REGION=global

# Default basemap for this installation: openfreemap, versatiles (open licences, global), outline (bundled Natural Earth coastlines, offline; China default), tianditu (mainland China, key required), custom (own tile service) or none.
# Use none or custom in networks without internet access
EUROGAS_NEXUS_MAP_DEFAULT_PROVIDER=openfreemap

# Restrict contracts, trades and books to the books named by each person's BOOKS: data scopes (head office BOOKS:*, regional heads their entity or region).
# Turn on for any installation shared by more than one office
EUROGAS_NEXUS_PORTFOLIO_ISOLATION=false

# Header carrying the user's e-mail address (optional).
EUROGAS_NEXUS_GATEWAY_EMAIL_HEADER=X-Remote-Email

# OpenAI-compatible chat-completions base URL of the model this installation uses (DeepSeek, OpenAI, Azure OpenAI, Mistral, Qwen, or a self-hosted vLLM/Ollama).
# Default: https://api.deepseek.com
# HTTPS required; plain HTTP only for a model on a private network. External LLM calls stay off in trial/release unless EUROGAS_NEXUS_LLM_EXTERNAL_PROVIDER_ENABLED allows them.
EUROGAS_NEXUS_LLM_BASE_URL=https://api.deepseek.com

# Model name sent to the LLM endpoint.
# Default: deepseek-v4-flash
# HTTPS required; plain HTTP only for a model on a private network. External LLM calls stay off in trial/release unless EUROGAS_NEXUS_LLM_EXTERNAL_PROVIDER_ENABLED allows them.
EUROGAS_NEXUS_LLM_MODEL=deepseek-v4-flash

# Provider label recorded in audit events and shown with LLM answers.
# Default: DEEPSEEK
# HTTPS required; plain HTTP only for a model on a private network. External LLM calls stay off in trial/release unless EUROGAS_NEXUS_LLM_EXTERNAL_PROVIDER_ENABLED allows them.
EUROGAS_NEXUS_LLM_PROVIDER_NAME=DEEPSEEK

# API key for the US EIA open-data API (Henry Hub daily spot price).
# Required when: Henry Hub ingestion (scripts/ops/ingest_eia.py) fetches from EIA
# Free on registration at eia.gov/opendata; EIA data is public domain. The key is sent as a query parameter and never logged.
# Secret: inject at deploy time; never commit a real value.
EIA_API_KEY=

# Security token for the ENTSO-E Transparency Platform (day-ahead power prices, load, wind, solar and gas-fired generation).
# Required when: power ingestion (scripts/ops/ingest_power.py) fetches from ENTSO-E
# Free after registering on transparency.entsoe.eu and requesting API access; the token is sent as a query parameter and never logged.
# Secret: inject at deploy time; never commit a real value.
ENTSOE_SECURITY_TOKEN=

# How Windows artifacts are signed: azure-artifact-signing (key in Microsoft's HSMs, signed by the workflow, verified here) or pfx (an internal enterprise CA).
# Default: pfx
# See docs/release/CODE_SIGNING.md
EUROGAS_NEXUS_WINDOWS_SIGNING_PROVIDER=pfx

# Explicit API origin the UAT SDK economics example calls.
# Required when: running scripts/examples/lng_capacity_economics.py
# No implicit default: the example refuses to run without an explicit origin.
# Must be an http(s) origin only, with no path, query, fragment or credentials.
# Loopback origins (127.0.0.1, localhost, ::1) need no further opt-in.
EUROGAS_UAT_API_BASE_URL=http://127.0.0.1:8000

# Opt in to an explicit non-loopback UAT API for the SDK economics example.
# Unset or empty keeps the example loopback-only; exactly '1' opts in.
# Any other value is refused.
# An opted-in non-loopback API origin must use HTTPS.
EUROGAS_UAT_ALLOW_NON_LOOPBACK=
