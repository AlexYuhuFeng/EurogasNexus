EUROGAS_NEXUS_ENV=development
EUROGAS_NEXUS_API_PROFILE=development
EUROGAS_NEXUS_VERSION=0.5.0

# Development fallback only. Trial and release modes must not silently fall
# back to local files.
EUROGAS_NEXUS_ALLOW_FILE_FALLBACK=true

# Deployment network posture. Default private_network_preview. Use
# security_accepted only with an operator-reviewed acceptance evidence file.
EUROGAS_NEXUS_DEPLOYMENT_POSTURE=private_network_preview
# EUROGAS_NEXUS_SECURITY_ACCEPTANCE_EVIDENCE=/secure/security-acceptance.md

# Who may call the API (owner decision D1). Every route profile identifies its callers now: a
# request that presents no credential is refused (401, or 503 when no deployment token is
# configured either), and the authentication routes plus the health probes are the only paths
# served without one. Set this to 1 only if this deployment really does trust its network - it
# restores the pre-D1 posture, where a caller presenting nothing acts as the compatibility
# principal - and the health payload will then report authentication=anonymous_allowed so the
# choice is visible. A credential that IS presented is always verified, either way.
# EUROGAS_NEXUS_ALLOW_ANONYMOUS_CALLERS=0

# The deployment token SDK/CLI callers present (X-Eurogas-Api-Key, Authorization: Bearer, or
# ?api_key= for SSE). Required in any profile now that callers are identified. An unconfigured
# deployment fails closed with 503 rather than serving unauthenticated callers.
# EUROGAS_NEXUS_PUBLIC_API_TOKEN=

# DEVELOPMENT ONLY credential login for POST /api/dev/auth/login. The route is
# mounted by the development route profile only; the internal and release
# profiles never register it. NEVER set these in a trial or release deployment,
# and never reuse a real user password. The username must match an existing
# ACTIVE identity principal (by name or email): this endpoint never creates,
# approves, or elevates a principal.
# EUROGAS_NEXUS_DEV_LOGIN_USERNAME=
# EUROGAS_NEXUS_DEV_LOGIN_PASSWORD=
