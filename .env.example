EUROGAS_NEXUS_ENV=development
EUROGAS_NEXUS_API_PROFILE=development
EUROGAS_NEXUS_VERSION=0.5.0

# Development fallback only. Trial and release modes must not silently fall
# back to local files.
EUROGAS_NEXUS_ALLOW_FILE_FALLBACK=true

# Deployment network posture. Default private_network_preview. Use
# security_accepted only with an operator-reviewed acceptance evidence file.
EUROGAS_NEXUS_DEPLOYMENT_POSTURE=private_network_preview
# EUROGAS_NEXUS_SECURITY_ACCEPTANCE_EVIDENCE=/secure/security-acceptance.md
