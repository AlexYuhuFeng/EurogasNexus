{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "changed_files",
    "tests",
    "compatibility",
    "unresolved"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "partial"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "db",
        "client",
        "security",
        "release"
      ],
      "properties": {
        "api": {
          "type": "string"
        },
        "db": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "security": {
          "type": "string"
        },
        "release": {
          "type": "string"
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
