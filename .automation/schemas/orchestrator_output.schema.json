{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "reason",
    "task_file",
    "review_outcome",
    "checkpoint_updated"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "delegate",
        "wait_human",
        "complete",
        "continue"
      ]
    },
    "reason": {
      "type": "string"
    },
    "task_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_outcome": {
      "type": "string",
      "enum": [
        "none",
        "accepted",
        "rework",
        "blocked"
      ]
    },
    "checkpoint_updated": {
      "type": "boolean"
    }
  }
}