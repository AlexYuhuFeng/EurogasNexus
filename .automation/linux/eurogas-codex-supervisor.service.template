[Unit]
Description=Eurogas Nexus Codex Autonomous Supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=-/etc/eurogas-codex-runner.env
ExecStart=__PYTHON__ __REPO__/.automation/scripts/supervisor.py
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
