# Provider credentials for a disposable test environment. Copy to .env.testing (ignored by
# Git), fill the keys you have, and load it explicitly; nothing loads it implicitly.
#
#   Local:   set -a; . ./.env.testing; set +a      (then start the API / scheduler)
#   Render:  service > Environment > "Add from .env", paste this file's lines
#
# Only provider keys belong here. Database URLs, session and encryption secrets and login
# passwords are deployment values: Render generates them; do not copy them between
# environments. Precedence (docs/deployment/PROVIDER_CREDENTIALS.md): an environment key
# overrides the encrypted credential store, except that a provider an administrator
# disabled stays disabled. A key does not enable a source, start ingestion, permit
# external model calls or grant a market-data licence.

# GIE AGSI+/ALSI (storage, LNG). Free registration at agsi.gie.eu. Also needs a
# certification record before live ingestion.
GIE_API_KEY=

# US EIA open data (Henry Hub daily spot). Free at eia.gov/opendata.
EIA_API_KEY=

# ENTSO-E Transparency Platform (day-ahead power, load, wind, solar).
ENTSOE_SECURITY_TOKEN=

# Model endpoint key (DeepSeek or any OpenAI-compatible endpoint). DEEPSEEK_API_KEY is an
# accepted alias. External calls also need EUROGAS_NEXUS_LLM_EXTERNAL_PROVIDER_ENABLED.
EUROGAS_NEXUS_LLM_API_KEY=
