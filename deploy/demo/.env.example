# Eurogas Nexus TEST/DEMO SERVER - settings for deploy/demo/compose.yaml. No real values here.
# Copy to deploy/demo/.env (git-ignored) and fill the three secrets. Not for a customer deployment.
# Guide: docs/deployment/SELF_HOSTED_DEMO.md

# --- Required secrets -------------------------------------------------------
# Password of the stack's own PostgreSQL (only the demo service reaches it).
DEMO_DB_PASSWORD=
# Encrypts stored provider keys and keys identity digests. Keep it stable.
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
EUROGAS_NEXUS_SECRET_KEY=
# The tester password (12+ characters, random). Testers type it with a user name
# (tester, demo.trader, demo.risk, ...). The stack refuses to start without it.
# python -c "import secrets;print(secrets.token_urlsafe(18))"
EUROGAS_NEXUS_DEV_LOGIN_PASSWORD=

# --- Where it listens ---------------------------------------------------------
# 127.0.0.1 keeps it on this machine. Use the https profile or a private tunnel for other
# devices; do not publish this port to the internet.
DEMO_BIND_ADDRESS=127.0.0.1
DEMO_PORT=8080
# Optional HTTPS front (docker compose --profile https up -d):
DEMO_SERVER_NAME=localhost
# internal = Caddy's local CA; an e-mail address = public certificate for a public DNS name.
DEMO_TLS=internal
DEMO_HTTPS_BIND_ADDRESS=0.0.0.0
DEMO_HTTPS_PORT=443
# Only if saving fails with origin_not_allowed: the URL the browser shows.
EUROGAS_NEXUS_CORS_ORIGINS=

# --- Build identity (shown by GET /api/runtime/release) ------------------------
# DEMO_GIT_SHA=$(git rev-parse HEAD) on the command line, or set here.
DEMO_GIT_SHA=
DEMO_GIT_REF=

# --- Database elsewhere (optional) ----------------------------------------------
# An external PostgreSQL instead of the stack's own, e.g.
# postgres://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require
DEMO_DATABASE_URL=
# CA for sslmode=verify-full: PEM text or a path inside the container.
EUROGAS_NEXUS_DB_SSL_ROOT_CERT=

# --- Demo data -----------------------------------------------------------------
# Change this value to re-seed the demo desk and restore the tester identities on the next start.
EUROGAS_NEXUS_DEMO_RESET_TOKEN=

# --- Optional integrations (off unless a key is set) --------------------------------
# Model key: turns AI on.
EUROGAS_NEXUS_LLM_API_KEY=
# Public-source keys: any one turns the live refresh and catch-up on (auto).
GIE_API_KEY=
EIA_API_KEY=
ENTSOE_SECURITY_TOKEN=
EUROGAS_NEXUS_DEMO_LIVE_SOURCES=auto
EUROGAS_NEXUS_DEMO_CATCH_UP_MAX_DAYS=45
EUROGAS_NEXUS_DEMO_REFRESH_HOURS=6
