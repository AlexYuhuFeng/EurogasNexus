# Eurogas Nexus TEST/DEMO SERVER - settings for deploy/demo/compose.yaml. No real values here.
# Copy to deploy/demo/.env (git-ignored) and fill the three secrets. Not for a customer deployment.
# Guide: docs/deployment/SELF_HOSTED_DEMO.md

# --- Required secrets -------------------------------------------------------
# Password of the stack's own PostgreSQL (only the demo service reaches it).
DEMO_DB_PASSWORD=
# Encrypts stored provider keys and keys identity digests. Keep it stable.
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
EUROGAS_NEXUS_SECRET_KEY=
# The tester password (12+ characters, random). Testers type it with a user name
# (tester, demo.trader, demo.risk, ...). The stack refuses to start without it.
# python -c "import secrets;print(secrets.token_urlsafe(18))"
EUROGAS_NEXUS_DEV_LOGIN_PASSWORD=

# --- Where it listens ---------------------------------------------------------
# 127.0.0.1 keeps it on this machine. Use the https profile or a private tunnel for other
# devices; do not publish this port to the internet.
DEMO_BIND_ADDRESS=127.0.0.1
DEMO_PORT=8080
# Optional HTTPS front (docker compose --profile https up -d):
DEMO_SERVER_NAME=localhost
# internal = Caddy's local CA; an e-mail address = public certificate for a public DNS name.
DEMO_TLS=internal
DEMO_HTTPS_BIND_ADDRESS=0.0.0.0
DEMO_HTTPS_PORT=443
# Only if saving fails with origin_not_allowed: the URL the browser shows.
EUROGAS_NEXUS_CORS_ORIGINS=

# --- Build identity (shown by GET /api/runtime/release) ------------------------
# DEMO_GIT_SHA=$(git rev-parse HEAD) on the command line, or set here.
DEMO_GIT_SHA=
DEMO_GIT_REF=

# --- Database elsewhere (optional) ----------------------------------------------
# An external PostgreSQL instead of the stack's own, e.g.
# postgres://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require
DEMO_DATABASE_URL=
# CA for sslmode=verify-full: PEM text or a path inside the container.
EUROGAS_NEXUS_DB_SSL_ROOT_CERT=

# --- Demo data -----------------------------------------------------------------
# Change this value to re-seed the demo desk and restore the tester identities on the next start.
EUROGAS_NEXUS_DEMO_RESET_TOKEN=
# The simulated exchange feed: a live screen of every demo hub, quotes every 1-5 seconds,
# every figure labelled simulated. on (default) or off.
EUROGAS_NEXUS_DEMO_EXCHANGE_FEED=on
# When it quotes: 24h (default here, a demo-only session that never closes, so the screens move
# at any hour; real ICE Endex and EEX gas sessions differ) or exchange (07:00-19:00 CET/CEST).
EUROGAS_NEXUS_DEMO_FEED_SESSION=24h

# --- Demo housekeeping (keeping the small disk from filling) -----------------------------
# The demo start runs housekeeping once after the seed and first catch-up, then every 6 hours.
# It removes only demo/public rows by rule; the product's audit trail is left alone. Every
# window is in days (the feed's simulated horizon in hours) and has a low-disk floor: when
# free space falls below the percentage below, every window is halved down to that floor.
# See docs/deployment/SELF_HOSTED_DEMO.md, "Keeping the demo's disk from filling".
EUROGAS_NEXUS_DEMO_KEEP_SIMULATED_HOURS=48
EUROGAS_NEXUS_DEMO_KEEP_PUBLIC_DAYS=120
EUROGAS_NEXUS_DEMO_KEEP_INGESTION_DAYS=14
EUROGAS_NEXUS_DEMO_KEEP_RAW_PAGE_DAYS=14
EUROGAS_NEXUS_DEMO_KEEP_ALERT_DAYS=30
EUROGAS_NEXUS_DEMO_KEEP_JOB_DAYS=14
EUROGAS_NEXUS_DEMO_KEEP_SESSION_DAYS=0
EUROGAS_NEXUS_DEMO_KEEP_OUTBOX_DAYS=14
EUROGAS_NEXUS_DEMO_KEEP_METER_DAYS=90
EUROGAS_NEXUS_DEMO_DISK_MIN_FREE_PCT=20
# Inside the demo container the PostgreSQL volume is not mounted (the database runs in the
# postgres service), so the database path is reported as "not visible"; the system disk ("/")
# is what the demo container itself can see. Set these to paths the container sees when the
# database is local.
EUROGAS_NEXUS_DEMO_DISK_DATABASE_PATH=/var/lib/postgresql/data
EUROGAS_NEXUS_DEMO_DISK_SYSTEM_PATH=/

# --- Demo test accounts (optional; THIS DEMO SERVER ONLY) -----------------------------
# Extra sign-in names, each with its own password, created as local accounts at start-up
# (re-applied on a reset, disabled when removed from the list). They copy the roles of the
# demo.* testers: test_trader -> demo.trader, test_risk -> demo.risk, ... The password may be
# shorter than the 12-character policy, so ANYONE WHO KNOWS IT CAN SIGN IN: never reuse it,
# and never set this on a customer server (the customer runtime refuses to start with it).
# An account holding the ADMIN role must be marked explicitly with :admin.
# Form: name:password[:admin],name:password,...  (or a JSON list; see SELF_HOSTED_DEMO.md)
# EUROGAS_NEXUS_DEMO_TEST_ACCOUNTS=test_trader:12345678,test_nl_trader:12345678,test_analyst:12345678,test_risk:12345678,test_manager:12345678,test_finance:12345678,test_compliance:12345678,test_ops:12345678,test_admin:12345678:admin
EUROGAS_NEXUS_DEMO_TEST_ACCOUNTS=

# --- Optional integrations (off unless a key is set) --------------------------------
# Model key: turns AI on.
EUROGAS_NEXUS_LLM_API_KEY=
# Public-source keys: any one turns the live refresh and catch-up on (auto).
GIE_API_KEY=
EIA_API_KEY=
ENTSOE_SECURITY_TOKEN=
EUROGAS_NEXUS_DEMO_LIVE_SOURCES=auto
EUROGAS_NEXUS_DEMO_CATCH_UP_MAX_DAYS=45
EUROGAS_NEXUS_DEMO_REFRESH_HOURS=6
# After the first catch-up the product's scheduler reads each source on its schedule (on),
# or catch-up rounds repeat every refresh interval without a scheduler (off).
EUROGAS_NEXUS_DEMO_SCHEDULER=on
