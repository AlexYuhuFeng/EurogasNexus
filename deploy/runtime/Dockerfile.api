# Build stage: produce the project wheel using hash-pinned build dependencies.
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

COPY requirements-build.lock requirements-runtime.lock ./
RUN python -m pip install --no-cache-dir --require-hashes \
    -r requirements-build.lock \
    -r requirements-runtime.lock

COPY pyproject.toml setup.py README.md ./
COPY src ./src
COPY packages ./packages
COPY scripts/release/verify_customer_artifact.py scripts/release/runtime_artifact_policy.json ./scripts/release/
RUN python -m pip wheel --no-deps --no-build-isolation . --wheel-dir /wheels \
    && python scripts/release/verify_customer_artifact.py --wheel /wheels/eurogas_nexus-*.whl

# Runtime stage: install only the locked runtime dependencies and the wheel.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --system eurogas \
    && useradd --system --gid eurogas --create-home eurogas

WORKDIR /app

COPY requirements-runtime.lock ./
RUN python -m pip install --no-cache-dir --require-hashes \
    -r requirements-runtime.lock

COPY --from=builder /wheels ./wheels
RUN python -m pip install --no-cache-dir --no-deps --no-index \
    --find-links ./wheels eurogas_nexus \
    && rm -rf ./wheels

COPY alembic.ini ./
COPY alembic ./alembic
COPY apps ./apps
# Explicit customer script payload. Do not restore a recursive scripts copy:
# it would ship development seeds, simulators and UAT fixtures in image layers.
COPY scripts/ops/backup_restore_drill.py \
     scripts/ops/backup_runtime.py \
     scripts/ops/check_config.py \
     scripts/ops/ingest_public_sources.py \
     scripts/ops/materialize_reference_edges.py \
     scripts/ops/migration_preflight.py \
     scripts/ops/prune_audit_events.py \
     scripts/ops/prune_job_records.py \
     scripts/ops/prune_runtime_data.py \
     scripts/ops/recover_stale_jobs.py \
     scripts/ops/refresh_cost_observations.py \
     scripts/ops/run_dataops_scheduler.py \
     scripts/ops/run_monitoring_worker.py \
     scripts/ops/run_public_ingestion_worker.py \
     scripts/ops/run_shadow_scheduler.py \
     scripts/ops/validate_runtime_db.py ./scripts/ops/
COPY scripts/ci/audit_dependencies.py ./scripts/ci/
COPY scripts/release/collect_python_license_texts.py \
     scripts/release/compatibility_check.py \
     scripts/release/generate_sboms.py \
     scripts/release/release_artifacts.py \
     scripts/release/release_metadata.py \
     scripts/release/smoke_release.py \
     scripts/release/verify_python_license_texts.py \
     scripts/release/verify_customer_artifact.py \
     scripts/release/runtime_artifact_policy.json ./scripts/release/

# Collect the license/notice texts of the locked runtime dependencies from this
# runtime stage's own installed purelib (after the locked dependency install and
# the project wheel, never the builder stage). The collector exits non-zero when
# a locked package yields no usable text, so a missing or incomplete collection
# fails the image build instead of shipping partial notices. The evidence ships
# inside the image under the documented licenses directory (see
# docs/policies/DEPENDENCY_POLICY.md): manifest.json records the
# requirements-runtime.lock SHA-256 and every copied text's source, size and
# SHA-256, and texts/ holds the original copied bytes.
RUN set -eu; \
    purelib="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    python scripts/release/collect_python_license_texts.py \
        --site-packages "$purelib" \
        --output-dir /usr/share/licenses/eurogas-nexus/python-license-texts \
        --runtime-lock requirements-runtime.lock \
    && chmod -R a+rX /usr/share/licenses/eurogas-nexus/python-license-texts

# Actual installed package + copied tool inventory and transitive imports.
# Neither verifier connects to the database or a provider.
RUN python scripts/release/verify_customer_artifact.py

RUN chown -R eurogas:eurogas /app
USER eurogas

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
