# Database tier of the pilot set (deploy/ha/compose.yaml). Copy to .env and fill in.
# Never commit the filled file. Every secret below is the firm's; nothing here is a default.

POSTGRES_DB=eurogas_nexus
POSTGRES_USER=nexus_owner
POSTGRES_PASSWORD=
# Login the standby streams with (created on the first primary's first start).
NEXUS_REPLICATION_PASSWORD=

# Ports each node publishes on its server (bind to the data-zone address in production).
PG_NODE1_BIND=127.0.0.1
PG_NODE1_PORT=5441
PG_NODE2_BIND=127.0.0.1
PG_NODE2_PORT=5442

# The firm's S3-compatible object storage for backups and the write-ahead log.
# Host name only (no https://); the bucket must exist. Path style suits on-premises stores,
# host style suits AWS. Write-once (object lock) retention on this bucket is recommended.
BACKUP_S3_ENDPOINT=objects.example.internal
BACKUP_S3_PORT=443
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_URI_STYLE=path
BACKUP_S3_BUCKET=nexus-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# The CA bundle that signed the store's TLS certificate, on this host (mounted read-only as
# /etc/nexus/objectstore-ca.crt in every database container).
BACKUP_S3_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# Encrypts every backup and WAL file before upload. Keep it in the firm's secret store too:
# without it no backup can be restored.
BACKUP_CIPHER_PASSPHRASE=

# Schedule: a full backup on this ISO weekday (7 = Sunday), a differential every other day,
# both after this UTC hour. The write-ahead log is shipped continuously, and at least every
# NEXUS_ARCHIVE_TIMEOUT_SECONDS when the database is quiet (this bounds the recovery point).
NEXUS_BACKUP_HOUR_UTC=1
NEXUS_FULL_BACKUP_WEEKDAY=7
NEXUS_ARCHIVE_TIMEOUT_SECONDS=60
BACKUP_RETENTION_FULL=2
BACKUP_PROCESS_MAX=2

# POSTGRES_USER is the cluster's superuser: only the database servers use it. Once, on the
# primary, create the separate roles (deploy/runtime/database_roles.sql; it replicates to the
# standby): the application connects as eurogas_app (no UPDATE or DELETE on the audit trail),
# the gated upgrade as eurogas_owner (docs/security/DATABASE_ROLES.md).
# The application tier (deploy/runtime/env.server.example) points at node 1 and lists node 2
# as a failover host:
#   EUROGAS_NEXUS_APP_DB_USER=eurogas_app      EUROGAS_NEXUS_OWNER_DB_USER=eurogas_owner
#   RUNTIME_STORE_DATABASE_URL=postgresql+pg8000://eurogas_app:<password>@pg-node1:5432/eurogas_nexus
#   EUROGAS_NEXUS_DB_FAILOVER_HOSTS=pg-node2:5432
#   EUROGAS_NEXUS_DB_STARTUP_WAIT_SECONDS=60
