# CR-12 release staging output (generated by dry-run/CI, never committed)
release-assets/
release-evidence/
release-context.json

# Local UI audit and acceptance captures (generated, never committed)
output/

# Browser/UAT acceptance output: screenshots, the per-run summary and the agent-research
# evidence the sweep writes. Generated by `scripts/uat/browser_workflow_smoke.mjs` (locally and
# in CI, which uploads it as a workflow artifact), so it is never committed - the recorded
# result belongs in the reports, the artefacts belong to the run that produced them.
artifacts/

# Local autonomous-development harness, never customer/source distribution.
/.automation/
