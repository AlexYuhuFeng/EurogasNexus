# Local UI audit and acceptance captures (generated, never committed)
output/

# Local remediation environment. Every working directory created while verifying this
# project starts with `.dnx-`: hash-locked dependency targets (.dnx-deps, .dnx-audit,
# .dnx-cov, .dnx-verify), captured evidence (.dnx-out), a local npm (.dnx-npm) and the
# embedded PostgreSQL server with its data directory (.dnx-pg, .dnx-pgdata). They are
# machine-local and regenerable, and one of them is a 180 MB dependency tree.
#
# The glob below is deliberate rather than an explicit list. An explicit list has been
# wrong three times, and the failure mode is the one the audit's CA-08 names: a single
# `git add -A` commits a local dependency tree into a public repository. `.dnx-cov` was
# briefly untracked-but-unignored before this line existed.
#
# No trailing slash, on purpose. `/.dnx-*/` matches only what is *inside* such a
# directory, so the directory itself would still show as untracked; `/.dnx-*` matches
# both, which is what "ignore this namespace" has to mean.
/.dnx-*

# Browser/UAT acceptance output: screenshots, the per-run summary and the agent-research
# evidence the sweep writes. Generated by `scripts/uat/browser_workflow_smoke.mjs` (locally and
# in CI, which uploads it as a workflow artifact), so it is never committed - the recorded
# result belongs in the reports, the artefacts belong to the run that produced them.
artifacts/

# Local autonomous-development harness, never customer/source distribution.
/.automation/
