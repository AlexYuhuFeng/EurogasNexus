{
  "schema_version": 2,
  "policy": "Mandatory gates are internal and must record PASS, or NOT_APPLICABLE only where this policy explicitly permits it. Every gate evidence file must be a schema-version 2 envelope (scripts/release/evidence_envelope.py) bound to the full tested commit SHA, the tested subject digest(s) for artifact/image-bound gates, the producing workflow/job/run identity, the producing environment and a fresh UTC timestamp. Envelope fields are self-declared text: the validator binds them to the release context, the actual release bundle files and these producer profiles, but that is not cryptographic provenance. G1 is stronger: its evidence must declare the verified CI run under report.ci_run, and the validator re-derives the run from the read-only GitHub API for the trusted repository and workflow at the exact release commit, requiring a completed successful run whose required jobs (including browser acceptance) all succeeded - a copied, stale or failed claim cannot pass, and missing/pending/unreachable state stays blocked. G8 is produced only by its declared evidence_runner from an actual pytest execution of tests/security, and the generic writer refuses any gate that declares an evidence_runner, so its status cannot be declared by argument. Every publication path (preview, RC and stable) runs this validator before its release write, so a channel publishes only the gates its own required_for rank demands; preview and RC therefore block until their mandatory evidence exists instead of publishing ungated. External gates stay PENDING_EXTERNAL until an evidence envelope records PASS and carries an approval identity configured in authorized_external_approvals; a CLI boolean can never complete them, and publication is fail-closed on any pending or unverifiable gate.",
  "code_signing": {
    "stable": "authenticode_required_for_windows_exe",
    "preview": "unsigned_pending_external_permitted",
    "rc": "unsigned_pending_external_permitted"
  },
  "evidence_policy": {
    "envelope_schema_version": 2,
    "max_age_days": 30,
    "future_skew_minutes": 15
  },
  "producers": {
    "validate": {
      "workflow": "release.yml",
      "job": "validate",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "reliability": {
      "workflow": "release.yml",
      "job": "reliability",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "dependency-scan": {
      "workflow": "release.yml",
      "job": "dependency-scan",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "web": {
      "workflow": "release.yml",
      "job": "web",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "assemble": {
      "workflow": "release.yml",
      "job": "assemble",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "container-acceptance": {
      "workflow": "release.yml",
      "job": "container-acceptance",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "ci-verification": {
      "workflow": "release.yml",
      "job": "validate",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "dry-run": {
      "workflow": "run_release_dry_run.py",
      "job": "*",
      "environment_prefix": "local-dry-run",
      "require_run_identity": false,
      "local_only": true
    }
  },
  "ci_acceptance": {
    "policy": "Read-only GitHub API contract for G1 (PILOT-B2). The validator queries only api.github.com, only for this repository and workflow path, at the full release commit; required job names are exactly the names the Actions API reports for the workflow file. Desktop packaging is intentionally not required: the main-branch run reports it as skipped, and native packaging is not pilot acceptance. This binds the source commit's CI run, not acceptance of the packaged artifact or image.",
    "repository": "AlexYuhuFeng/EurogasNexus",
    "api_host": "api.github.com",
    "workflow_path": ".github/workflows/ci.yml",
    "event": "push",
    "required_jobs": [
      "validate",
      "Dependency license & CVE audit",
      "PostgreSQL integration",
      "web-client-build",
      "Browser acceptance (EN/ZH, 3 viewports)"
    ],
    "max_pages": 10,
    "request_timeout_seconds": 20,
    "max_attempts": 3
  },
  "authorized_external_approvals": [],
  "gates": [
    {
      "id": "G1",
      "name": "CI workflow",
      "type": "internal",
      "required_for": "all",
      "evidence": "ci-run.json",
      "subject_kind": "source",
      "not_applicable_allowed": false,
      "producers": ["ci-verification", "dry-run"],
      "verification": "same_sha_ci_run"
    },
    {
      "id": "G2",
      "name": "Unit/integration tests",
      "type": "internal",
      "required_for": "all",
      "evidence": "python-tests.json",
