{
  "schema_version": 2,
  "policy": "Mandatory gates are internal and must record PASS, or NOT_APPLICABLE only where this policy explicitly permits it. Every gate evidence file must be a schema-version 2 envelope (scripts/release/evidence_envelope.py) bound to the full tested commit SHA, the tested subject digest(s) for artifact/image-bound gates, the producing workflow/job/run identity, the producing environment and a fresh UTC timestamp. Envelope fields are self-declared text: the validator binds them to the release context, the actual release bundle files and these producer profiles, but that is not cryptographic provenance. External gates stay PENDING_EXTERNAL until an evidence envelope records PASS and carries an approval identity configured in authorized_external_approvals; a CLI boolean can never complete them. Stable publication is fail-closed on any pending or unverifiable gate.",
  "code_signing": {
    "stable": "authenticode_required_for_windows_exe",
    "preview": "unsigned_pending_external_permitted",
    "rc": "unsigned_pending_external_permitted"
  },
  "evidence_policy": {
    "envelope_schema_version": 2,
    "max_age_days": 30,
    "future_skew_minutes": 15
  },
  "producers": {
    "validate": {
      "workflow": "release.yml",
      "job": "validate",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "reliability": {
      "workflow": "release.yml",
      "job": "reliability",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "dependency-scan": {
      "workflow": "release.yml",
      "job": "dependency-scan",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "web": {
      "workflow": "release.yml",
      "job": "web",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "assemble": {
      "workflow": "release.yml",
      "job": "assemble",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "container-acceptance": {
      "workflow": "release.yml",
      "job": "container-acceptance",
      "environment_prefix": "github-actions/",
      "require_run_identity": true
    },
    "dry-run": {
      "workflow": "run_release_dry_run.py",
      "job": "*",
      "environment_prefix": "local-dry-run",
      "require_run_identity": false,
      "local_only": true
    }
  },
  "authorized_external_approvals": [],
  "gates": [
    {
      "id": "G1",
      "name": "CI workflow",
      "type": "internal",
      "required_for": "rc",
      "evidence": "ci-run.json",
      "subject_kind": "source",
      "not_applicable_allowed": false,
      "producers": ["dry-run"]
    },
    {
      "id": "G2",
      "name": "Unit/integration tests",
      "type": "internal",
      "required_for": "all",
      "evidence": "python-tests.json",
      "subject_kind": "source",
      "not_applicable_allowed": false,
      "producers": ["validate", "dry-run"]
    },
    {
      "id": "G3",
      "name": "PostgreSQL migration",
      "type": "internal",
      "required_for": "all",
      "evidence": "postgres-migration.json",
      "subject_kind": "source",
      "not_applicable_allowed": false,
      "producers": ["reliability", "dry-run"]
    },
    {
